# Copy to backend/.env (gitignored).

PORT=3000

# ── Supabase (server-only; service_role bypasses RLS — never expose to the browser)
# dashboard-dev (in-use test DB)
SUPABASE_URL=https://ysxratyafjiemwzrexsk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Personal Dashboard (backup test DB, for trying big DB changes first)
#SUPABASE_URL=https://zkgyutbitqmnfoxbhtim.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (Authelia OIDC). Names are fixed by @hono/oidc-auth.
# true skips login entirely (refused when NODE_ENV=production).
AUTH_DISABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# ≥32 chars; signs the session cookie. e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))"
OIDC_AUTH_SECRET=
# Dev goes through the frontend's Vite proxy so cookies land on its origin.
# Must be registered as a redirect URI on the Authelia client.
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# Refresh tokens need offline_access allowed on the Authelia client.
OIDC_SCOPES=openid profile email offline_access

# ── VPS single-process mode: also serve the built SPA
SERVE_STATIC=false
STATIC_ROOT=../frontend/build
